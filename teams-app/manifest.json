{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "{{MICROSOFT_APP_ID}}",
  "packageName": "com.chatops.teams",
  "developer": {
    "name": "ChatOps Team",
    "websiteUrl": "https://{{AZURE_APP_SERVICE_DOMAIN}}",
    "privacyUrl": "https://{{AZURE_APP_SERVICE_DOMAIN}}/privacy",
    "termsOfUseUrl": "https://{{AZURE_APP_SERVICE_DOMAIN}}/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "ChatOps Teams",
    "full": "ChatOps Teams - GitHub Security & Deployment Integration"
  },
  "description": {
    "short": "GitHub security alerts and deployment approvals in Teams",
    "full": "ChatOps Teams integrates GitHub security alerts (code scanning, Dependabot) and deployment approval workflows directly into Microsoft Teams. Receive real-time notifications for critical vulnerabilities and approve deployments without leaving Teams."
  },
  "accentColor": "#5558AF",
  "bots": [
    {
      "botId": "{{MICROSOFT_APP_ID}}",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "commandLists": [
        {
          "scopes": [
            "personal",
            "team",
            "groupchat"
          ],
          "commands": [
            {
              "title": "help",
              "description": "Get help with ChatOps Teams commands"
            },
            {
              "title": "status",
              "description": "Check the status of your repositories and alerts"
            },
            {
              "title": "subscribe",
              "description": "Subscribe to alerts for a repository"
            },
            {
              "title": "unsubscribe",
              "description": "Unsubscribe from repository alerts"
            }
          ]
        }
      ]
    }
  ],
  "connectors": [
    {
      "connectorId": "{{MICROSOFT_APP_ID}}",
      "scopes": [
        "team"
      ]
    }
  ],
  "composeExtensions": [
    {
      "botId": "{{MICROSOFT_APP_ID}}",
      "canUpdateConfiguration": true,
      "commands": [
        {
          "id": "searchAlerts",
          "type": "query",
          "title": "Search Security Alerts",
          "description": "Search for GitHub security alerts",
          "initialRun": false,
          "parameters": [
            {
              "name": "query",
              "title": "Search Query",
              "description": "Search for alerts by repository, severity, or type"
            }
          ]
        },
        {
          "id": "searchDeployments",
          "type": "query",
          "title": "Search Deployments",
          "description": "Search for pending deployment approvals",
          "initialRun": false,
          "parameters": [
            {
              "name": "environment",
              "title": "Environment",
              "description": "Filter by environment (e.g., production, staging)"
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "{{AZURE_APP_SERVICE_DOMAIN}}",
    "token.botframework.com",
    "github.com"
  ],
  "webApplicationInfo": {
    "id": "{{ENTRA_CLIENT_ID}}",
    "resource": "api://{{AZURE_APP_SERVICE_DOMAIN}}/{{ENTRA_CLIENT_ID}}"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        },
        {
          "name": "TeamSettings.Read.Group",
          "type": "Application"
        }
      ]
    }
  },
  "configurableTabs": [],
  "staticTabs": [
    {
      "entityId": "about",
      "name": "About",
      "contentUrl": "https://{{AZURE_APP_SERVICE_DOMAIN}}/tabs/about",
      "websiteUrl": "https://{{AZURE_APP_SERVICE_DOMAIN}}/tabs/about",
      "scopes": [
        "personal"
      ]
    }
  ],
  "showLoadingIndicator": false,
  "isFullScreen": false,
  "activities": {
    "activityTypes": [
      {
        "type": "securityAlert",
        "description": "Security alert notification",
        "templateText": "{actor} triggered a {alertType} alert in {repository}"
      },
      {
        "type": "deploymentApproval",
        "description": "Deployment approval request",
        "templateText": "{actor} requested approval for deployment to {environment}"
      }
    ]
  },
  "defaultBlockUntilAdminAction": false,
  "publisherDocsUrl": "https://{{AZURE_APP_SERVICE_DOMAIN}}/docs",
  "defaultInstallScope": "team",
  "defaultGroupCapability": {
    "team": "bot",
    "groupchat": "bot"
  },
  "localizationInfo": {
    "defaultLanguageTag": "en-us",
    "additionalLanguages": [
      {
        "languageTag": "en-us",
        "file": "locales/en-us.json"
      }
    ]
  }
}
